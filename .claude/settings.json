{
  "permissions": {
    "deny": [
      "Read(**/.credentials.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(claude setup-token*)",
      "Bash(claude auth logout*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 900
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/plugin/hooks/coach.sh",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "workflowSizeGuideline": "large"
}
