# Pixi's solved environment: reconstructable from pixi.lock, never committed. Without the slash,
# so a worktree whose .pixi is a link to the main checkout's environment is covered too.
.pixi

# Python
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Apptainer images are large and are rebuilt from their recipe; an image is never committed.
*.sif

# Secrets never enter the repository. The real values live in the environment.
.env
.env.*
*.pem

# The evidence report's default directory (python -m beethoven_qa report); it is handed over, never
# committed, and an untracked folder would make the pre-push hook refuse the next push.
report/

# Worktrees Claude Code creates for parallel sessions and isolated subagents.
.claude/worktrees/
# The file Claude Code writes on an "always allow" answer: one person's permissions, never shared,
# and an untracked file would make the pre-push hook refuse every push from that checkout.
.claude/settings.local.json

# OS / editor noise
.DS_Store
Thumbs.db
*.log
